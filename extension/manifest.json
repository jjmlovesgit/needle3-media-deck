{
  "manifest_version": 3,
  "name": "Media Deck",
  "version": "0.3.24",
  "minimum_chrome_version": "141",
  "key": "",
  "description": "Create karaoke from timed captions, organize local media, and control private playback from Media Deck.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "tabs", "storage", "nativeMessaging", "sidePanel"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtu.be/*", "https://suno.com/*", "https://www.suno.com/*", "http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8765/play/*"],
      "js": ["player_bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Media Deck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {"default_path": "sidepanel.html"}
}
